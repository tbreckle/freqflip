# Auto detect text files and normalize line endings to LF
* text=auto

# Source code
*.rs text eol=lf
*.py text eol=lf
*.toml text eol=lf

# Shell scripts
*.sh text eol=lf

# Config files
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Documentation
*.md text eol=lf
LICENSE text eol=lf

# Binary files
*.exe binary
*.zip binary
*.gz binary

# Media files
*.png binary
*.ico binary
*.icns binary
